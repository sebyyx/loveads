# PHP version
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>

# Canonical host + HTTPS, in a single redirect.
# Both loveads.ro and www.loveads.ro used to answer 200 with identical content, which
# splits link signals across two hostnames. The canonical tag already points at the
# non-www host, so that is the one we redirect to. Combining the two conditions keeps
# it to one hop: www + http never chains through a second 301.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://loveads.ro%{REQUEST_URI} [L,R=301]

# Cache policy.
# Images, icons and fonts carry stable filenames and can be cached hard. Stylesheets
# deliberately get one day, not a year: this site has no build step and no hashed
# filenames, so a long cache would strand visitors on an old site.css after a deploy.
# HTML is never cached, so a deploy is visible immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 day"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 day"
  ExpiresByType application/javascript    "access plus 1 day"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|svg|webp|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
